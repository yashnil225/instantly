{
  "name": "instantly-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for the Instantly Cold Outreach Platform",
  "main": "dist/index.js",
  "bin": {
    "instantly-mcp-server": "./dist/index.js",
    "instantly-mcp-http": "./dist/http.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "test": "tsx scripts/test-client.ts",
    "test:crud": "tsx scripts/test-crud.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.19",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
